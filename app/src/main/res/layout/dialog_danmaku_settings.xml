<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F0181818">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/danmaku_enabled_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/danmaku_enabled"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/danmaku_match_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/danmaku_match_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_match_button"
                android:textColor="#00A4DC" />

            <Button
                android:id="@+id/danmaku_reload_button"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_reload_button"
                android:textColor="#00A4DC" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/danmaku_offset_label"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/danmaku_offset_minus"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:text="@string/danmaku_offset_minus"
                android:textColor="@android:color/white" />

            <EditText
                android:id="@+id/danmaku_offset_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="@string/danmaku_offset_hint"
                android:importantForAutofill="no"
                android:inputType="numberDecimal|numberSigned"
                android:textColor="@android:color/white"
                android:textColorHint="#66FFFFFF" />

            <Button
                android:id="@+id/danmaku_offset_plus"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:text="@string/danmaku_offset_plus"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/danmaku_opacity_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/danmaku_opacity_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/danmaku_font_size_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/danmaku_font_size_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/danmaku_speed_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/danmaku_speed_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/danmaku_height_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/danmaku_height_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/danmaku_mode_filter"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/danmaku_mode_scroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_mode_scroll"
                android:textColor="@android:color/white" />

            <CheckBox
                android:id="@+id/danmaku_mode_top"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_mode_top"
                android:textColor="@android:color/white" />

            <CheckBox
                android:id="@+id/danmaku_mode_bottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_mode_bottom"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/danmaku_source_filter"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/danmaku_source_bilibili"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_source_bilibili"
                android:textColor="@android:color/white" />

            <CheckBox
                android:id="@+id/danmaku_source_gamer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_source_gamer"
                android:textColor="@android:color/white" />

            <CheckBox
                android:id="@+id/danmaku_source_dandan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_source_dandan"
                android:textColor="@android:color/white" />

            <CheckBox
                android:id="@+id/danmaku_source_other"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_source_other"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/danmaku_density_limit"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/danmaku_density_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/danmaku_density_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_density_off"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/danmaku_density_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_density_low"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/danmaku_density_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_density_medium"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/danmaku_density_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_density_high"
                android:textColor="@android:color/white" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/danmaku_ch_convert"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/danmaku_ch_convert_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/danmaku_ch_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_ch_convert_none"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/danmaku_ch_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_ch_convert_simplified"
                android:textColor="@android:color/white" />

            <RadioButton
                android:id="@+id/danmaku_ch_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/danmaku_ch_convert_traditional"
                android:textColor="@android:color/white" />
        </RadioGroup>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/danmaku_anti_overlap_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/danmaku_anti_overlap"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/danmaku_use_xml_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/danmaku_use_xml"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/danmaku_custom_api"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/danmaku_custom_api_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/danmaku_custom_api_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:textColor="@android:color/white"
            android:textColorHint="#66FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/danmaku_reload_note"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
